# ProjectPilot AI — Environment Configuration Example

# Server Environment & Security
ENVIRONMENT=development
PORT=8000
SECRET_KEY=generate_a_random_secret_key_here

# Database Connection (Defaults to local SQLite file if unconfigured)
# SQLite (Local):
DATABASE_URL=sqlite:///./projectpilot.db
# PostgreSQL (Production / Render):
# DATABASE_URL=postgresql://user:password@localhost:5432/projectpilot

# Google Gemini AI Key
GEMINI_API_KEY=your_gemini_api_key_here

# Allowed CORS Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://projectpilot-ai.vercel.app
